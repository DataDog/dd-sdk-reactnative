{
    "eslint.enable": true,
    "eslint.validate": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact"
    ],
    "[json]": {
        "files.insertFinalNewline": true,
        "files.trimFinalNewlines": true,
    },
    "[ignore]": {
        "editor.formatOnSave": false
    },
    "[javascript]": {
        "editor.formatOnSave": false
    },
    "[javascriptreact]": {
        "editor.formatOnSave": false
    },
    "[typescript]": {
        "editor.formatOnSave": false
    },
    "[typescriptreact]": {
        "editor.formatOnSave": false
    },
    "prettier.disableLanguages": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact"
    ],
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },
    "typescript.tsdk": "node_modules/typescript/lib",
    "workbench.colorCustomizations": {
        "activityBar.background": "#580F33",
        "titleBar.activeBackground": "#7C1648",
        "titleBar.activeForeground": "#FEFCFD",
        "titleBar.inactiveBackground": "#580F33",
        "titleBar.inactiveForeground": "#FEFCFD",
        "statusBar.background": "#580F33",
        "statusBar.foreground": "#FEFCFD",
        "statusBar.debuggingBackground": "#580F33",
        "statusBar.debuggingForeground": "#FEFCFD",
        "statusBar.noFolderBackground": "#580F33",
        "statusBar.noFolderForeground": "#FEFCFD"
    },
}